# Public configuration
GARMIN_DAILY_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/nora-health-garmin-daily-pilot

# Secret shared only between this bridge and the n8n webhook credential.
GARMIN_DAILY_WEBHOOK_SECRET=replace-in-vps-secret-store

# Credentials are needed only for the one-time interactive bootstrap. Remove
# both lines from the long-running container after /tokens is initialized.
GARMIN_CONNECT_USERNAME=
GARMIN_CONNECT_PASSWORD=
