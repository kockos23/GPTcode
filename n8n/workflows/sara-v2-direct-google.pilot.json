    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const [messageIndex, item] of $input.all().entries()) {\n  const messageId = String(item.json.id || '');\n  if (!messageId) throw new Error('Gmail správa nemá ID');\n  for (const [key, file] of Object.entries(item.binary || {})) {\n    const mime = String(file.mimeType || '').toLowerCase();\n    if (!['application/pdf', 'image/jpeg', 'image/png'].includes(mime)) continue;\n    const name = String(file.fileName || key);\n    const attachmentId = String(file.id || file.attachmentId || key);\n    out.push({\n      json: {\n        source: 'gmail',\n        sourceMessageId: messageId,\n        sourceThreadId: item.json.threadId || '',\n        originalFileName: name,\n        mimeType: mime,\n        attachmentKey: key,\n        attachmentId,\n        documentKey: 'gmail:' + messageId + ':' + attachmentId,\n        sender: item.json.From || item.json.from || '',\n        subject: item.json.Subject || item.json.subject || '',\n        receivedAt: item.json.internalDate || '',\n      },\n      binary: { data: file },\n      pairedItem: { item: messageIndex },\n    });\n  }\n}\nreturn out;"
