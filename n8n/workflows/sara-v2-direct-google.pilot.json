    {
      "parameters": {
        "jsCode": "const folderMap = {\n  '2026-07': {Doklady:'1xBLtB_kKK-2CGszvw5qIijPvaimMcgYZ',Stripe:'1fPGEOm-e9dxC6f4VwZGN6BiYo7aLO9kK',Vystavene_FA:'1CB5ALMIwfkn-Ra3ofhSur004_qELuVfb',Vypisy:'1Fa3Q3nveiwBNuqNrk9Z36-ivgs7XW4H6'},\n  '2026-09': {Doklady:'1ENIbEKDU5-MB1OQdwahVxaX3QsmbOJ9P',Stripe:'1FnnoyRvHUZvIqt_6ubrqlKc7IizwIzoJ',Vystavene_FA:'1smwM_plG5R_TDKamgLXJ7FEgOVmk7v8F',Vypisy:'1GRCKWFpVLhlS9wNPQTBnInj9ilvRq1yM'},\n  '2026-10': {Doklady:'1-S5LCmm-gbY8HSP_LF2Ewk7OprS31ztM',Stripe:'1ddVXlQws6c_LJdk5adR_q_mDQCJgvgvd',Vystavene_FA:'10fglKBDhYYgcrI6IvXs4-yMcWlx93tLl',Vypisy:'1ei0M6b48vdRyYtWybhd4OVRlpGXjMcaU'},\n};\nconst allowedDestinations = new Set(['Doklady','Stripe','Vypisy','Vystavene_FA']);\nconst clean = v => typeof v === 'string' ? v.trim() : '';\nconst num = v => typeof v === 'number' && Number.isFinite(v) ? v : null;\nconst date = v => { const s=clean(v); if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) return ''; const d=new Date(s+'T00:00:00Z'); return !Number.isNaN(d.getTime())&&d.toISOString().slice(0,10)===s?s:''; };\nconst safe = v => clean(v).replace(/[\\/:*?\"<>|]/g,'-').replace(/[\\r\\n]/g,' ').slice(0,100);\nconst out=[];\nfor(const [index,item] of $input.all().entries()){\n  const j=item.json||{}, meta=j.meta||{};\n  let text=j.output_text||j.choices?.[0]?.message?.content||'';\n  if(!text&&Array.isArray(j.output)) text=j.output.flatMap(x=>x.content||[]).filter(x=>x.type==='output_text').map(x=>x.text||'').join('');\n  if(!text&&Array.isArray(j.content)) text=j.content.filter(x=>x.type==='text').map(x=>x.text||'').join('');\n  let d={}, parseError=false;\n  try { d=JSON.parse(String(text).replace(/^\\s*\\x60{3}(?:json)?/i,'').replace(/\\x60{3}\\s*$/,'').trim()); if(!d||typeof d!=='object'||Array.isArray(d)) throw Error('invalid'); }\n  catch { parseError=true; }\n  const docDate=date(d.docDate), deliveryDate=date(d.deliveryDate), dueDate=date(d.dueDate), periodEndDate=date(d.periodEndDate);\n  const destination=allowedDestinations.has(clean(d.destination))?clean(d.destination):'';\n  const periodDate=(destination==='Stripe'||destination==='Vypisy')?periodEndDate:deliveryDate;\n  const accountingPeriod=periodDate.slice(0,7);\n  const targetFolderId=folderMap[accountingPeriod]?.[destination]||'';\n  const totalAmount=num(d.totalAmount), netAmount=num(d.netAmount), vatAmount=num(d.vatAmount), vatRate=num(d.vatRate);\n  const supplier=clean(d.supplier), currency=/^[A-Z]{3}$/.test(clean(d.currency).toUpperCase())?clean(d.currency).toUpperCase():'';\n  const reportedConfidence=num(d.confidence)===null?0:Math.max(0,Math.min(100,d.confidence));\n  const issues=[];\n  if(parseError) issues.push('Odpoveď AI nie je platný JSON');\n  if(!destination) issues.push('Neurčený cieľ dokumentu');\n  if((destination==='Doklady'||destination==='Vystavene_FA')&&!deliveryDate) issues.push('Chýba dátum dodania/DUZP');\n  if((destination==='Stripe'||destination==='Vypisy')&&!periodEndDate) issues.push('Chýba koniec obdobia reportu');\n  if(!accountingPeriod) issues.push('Neurčené účtovné obdobie');\n  if(accountingPeriod&&!targetFolderId) issues.push('Pre obdobie neexistuje overený cieľový priečinok');\n  if(!supplier&&destination!=='Vypisy') issues.push('Chýba partner');\n  if(totalAmount===null&&destination!=='Vypisy') issues.push('Chýba suma');\n  if(reportedConfidence<80) issues.push('Istota extrakcie je nižšia ako 80 %');\n  if(netAmount!==null&&vatAmount!==null&&totalAmount!==null&&Math.abs(netAmount+vatAmount-totalAmount)>0.02) issues.push('Nesedí základ + DPH = celkom');\n  const routeReady=issues.length===0;\n  const processedAt=new Date().toISOString();\n  const originalFileName=clean(meta.originalFileName||item.binary?.data?.fileName)||'doklad';\n  const ext=originalFileName.match(/\\.([a-zA-Z0-9]{1,8})$/)?.[1]?.toLowerCase()||'pdf';\n  const documentKey=clean(meta.documentKey);\n  const stableId='WOF-'+documentKey.replace(/[^a-zA-Z0-9_-]/g,'-').slice(0,120);\n  const fileName=[periodDate||'bez-datumu',safe(supplier)||destination||'Neznamy',safe(d.invoiceNumber)||'bez-cisla',totalAmount===null?'suma-neznama':totalAmount.toFixed(2),currency||'mena-neznama'].join('_').slice(0,180)+'.'+ext;\n  out.push({json:{\n    id:stableId, documentKey, processedAt, updatedAt:processedAt,\n    source:'gmail', sender:clean(meta.sender), sourceMessageId:clean(meta.sourceMessageId), sourceThreadId:clean(meta.sourceThreadId), attachmentId:clean(meta.attachmentId),\n    docType:clean(d.docType)||'Neurčené', destination, docDate, deliveryDate, dueDate, periodEndDate,\n    accountingPeriod, periodCandidate:accountingPeriod, year:accountingPeriod?Number(accountingPeriod.slice(0,4)):'', monthLabel:accountingPeriod,\n    supplier, ico:clean(d.ico), dic:clean(d.dic), icDph:clean(d.icDph), invoiceNumber:clean(d.invoiceNumber), variableSymbol:clean(d.variableSymbol),\n    netAmount, vatRate, vatAmount, totalAmount, currency, category:clean(d.category), description:clean(d.description),\n    confidence:reportedConfidence, reportedConfidence, parseError, routeReady, targetFolderId,\n    status:'Na kontrolu', reviewReason:issues.join('; '), fileName, originalFileName,\n    runId:String($execution.id), extractionVersion:'sara-v2-direct-google-20261028',\n  },binary:item.binary,pairedItem:{item:index}});\n}\nreturn out;"
      },
